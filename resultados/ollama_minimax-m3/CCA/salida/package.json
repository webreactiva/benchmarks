{
  "name": "scalable-cart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Scalable shopping cart: hexagonal architecture, Redis-backed, horizontally scalable, with a React storefront.",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "npm run build -w @cart/core && npm run build -w @cart/server && npm run build -w @cart/client",
    "build:core": "npm run build -w @cart/core",
    "build:server": "npm run build -w @cart/server",
    "build:client": "npm run build -w @cart/client",
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev -w @cart/server",
    "dev:client": "npm run dev -w @cart/client",
    "start": "npm run start -w @cart/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck -w @cart/core && npm run typecheck -w @cart/server && npm run typecheck -w @cart/client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf packages/*/dist packages/*/coverage",
    "dev:all": "npm run dev",
    "test:redis": "REDIS_TEST_URL=${REDIS_TEST_URL:-redis://localhost:6379} vitest run --project server",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^5.4.21",
    "vitest": "^3.2.7",
    "npm-run-all": "^4.1.5"
  }
}
