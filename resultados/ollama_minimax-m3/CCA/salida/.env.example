# ---- HTTP server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ---- Redis (shared state => horizontal scaling) ----
# Leave REDIS_URL empty to run with the in-memory adapters (single node demo).
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=cart:

# ---- Cart business rules ----
MAX_QUANTITY_PER_LINE=10
MAX_DISTINCT_LINES=50
MAX_UNITS_PER_CART=100
CART_TTL_SECONDS=2592000
IDEMPOTENCY_TTL_SECONDS=86400
CART_WRITE_RETRIES=5

# ---- Catalog / pricing ----
CATALOG_SOURCE=seed
CATALOG_URL=
CATALOG_CACHE_TTL_MS=30000
TAX_RATE=0.21
SHIPPING_FLAT_AMOUNT=499
FREE_SHIPPING_THRESHOLD=5000
CURRENCY=EUR

# ---- Client ----
VITE_API_BASE_URL=http://localhost:3000/api/v1
