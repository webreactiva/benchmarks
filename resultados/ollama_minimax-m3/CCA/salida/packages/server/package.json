{
  "name": "@cart/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP API for the shopping cart: Fastify + Redis adapters, idempotency, metrics and SSE.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc -b tsconfig.json --pretty",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@cart/core": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "pino": "^9.14.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
