              "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Ruta 3D - Alhambra de Granada</title>\n<style>\n  html,body{margin:0;height:100%;overflow:hidden;background:#0b3d2e;font-family:system-ui,Segoe UI,Roboto,sans-serif;}\n  #canvas{display:block;width:100%;height:100%;}\n  #ui{position:fixed;top:12px;left:12px;background:rgba(0,0,0,.55);color:#fff;padding:12px 14px;border-radius:10px;max-width:300px;backdrop-filter:blur(4px);}\n  #ui h1{font-size:16px;margin:0 0 6px;}\n  #ui p{font-size:12px;margin:4px 0;opacity:.9;}\n  #stops{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}\n  .stop{background:#d4af37;color:#222;border:none;border-radius:6px;padding:4px 8px;cursor:pointer;font-size:12px;}\n  .stop:hover{background:#e7c35a;}\n  #info{position:fixed;bottom:12px;left:12px;background:rgba(0,0,0,.55);color:#fff;padding:10px 14px;border-radius:10px;max-width:360px;backdrop-filter:blur(4px);font-size:13px;}\n  #legend{position:fixed;top:12px;right:12px;background:rgba(0,0,0,.55);color:#fff;padding:10px 14px;border-radius:10px;font-size:12px;}\n  .dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:middle;}\n  .label{color:#fff;font-size:11px;background:rgba(0,0,0,.4);padding:2px 6px;border-radius:4px;white-space:nowrap;}\n</style>\n</head>\n<body>\n<div id=\"ui\">\n  <h1>Alhambra de Granada</h1>\n  <p>Ruta 3D por el conjunto monumental. Pulsa un punto o \"Tour\".</p>\n  <div id=\"stops\"></div>\n  <div style=\"margin-top:8px;display:flex;gap:6px;\">\n    <button class=\"stop\" id=\"tourBtn\">Tour automático</button>\n    <button class=\"stop\" id=\"resetBtn\">Vista general</button>\n  </div>\n</div>\n<div id=\"info\">Selecciona un punto de la ruta.</div>\n<div id=\"legend\">\n  <div><span class=\"dot\" style=\"background:#c94c4c\"></span>Palacios nasridas</div>\n  <div><span class=\"dot\" style=\"background:#8b7355\"></span>Fortaleza (Alcazaba)</div>\n  <div><span class=\"dot\" style=\"background:#2e7d32\"></span>Jardines (Generalife)</div>\n  <div><span class=\"dot\" style=\"background:#a08a6b\"></span>Otros edificios</div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/renderers/CSS2DRenderer.js\"></script>\n<script>\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(0x87b9e6);\nscene.fog=new THREE.Fog(0x87b9e6,120,400);\n\nconst camera=new THREE.PerspectiveCamera(60,innerWidth/innerHeight,0.1,1000);\ncamera.position.set(0,120,160);\n\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.shadowMap.enabled=true;\ndocument.body.appendChild(renderer.domElement);\nrenderer.domElement.id='canvas';\n\nconst labelRenderer=new THREE.CSS2DRenderer();\nlabelRenderer.setSize(innerWidth,innerHeight);\nlabelRenderer.domElement.style.position='absolute';\nlabelRenderer.domElement.style.top='0';\nlabelRenderer.domElement.style.pointerEvents='none';\ndocument.body.appendChild(labelRenderer.domElement);\n\nconst controls=new THREE.OrbitControls(camera,renderer.domElement);\ncontrols.enableDamping=true;\ncontrols.maxPolarAngle=Math.PI/2.1;\n\nconst hemi=new THREE.HemisphereLight(0xffffff,0x445566,0.7);\nscene.add(hemi);\nconst sun=new THREE.DirectionalLight(0xfff4d6,0.9);\nsun.position.set(80,150,60);\nsun.castShadow=true;\nsun.shadow.mapSize.set(2048,2048);\nscene.add(sun);\n\nconst ground=new THREE.Mesh(\n  new THREE.PlaneGeometry(500,500,80,80),\n  new THREE.MeshStandardMaterial({color:0x5a8f4a,roughness:0.9})\n);\nground.rotation.x=-Math.PI/2;\nground.receiveShadow=true;\nscene.add(ground);\n\nfunction box(cx,cy,cz,w,h,d,color=0xa08a6b,cat='other'){\n  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),new THREE.MeshStandardMaterial({color,roughness:0.8}));\n  m.position.set(cx,cy+h/2,cz);\n  m.castShadow=true;m.receiveShadow=true;\n  m.userData.cat=cat;\n  scene.add(m);\n  return m;\n}\nfunction wall(cx,cz,w,d,h=8,color=0xb8a88a){\n  return box(cx,h/2,cz,w,h,d,color);\n}\n\n// Main palace (Palacios Nazaríes)\nbox(0,0,0,60,6,40,0xc94c4c,'nasrid'); // base\nbox(-15,6,0,18,10,24,0xc94c4c,'nasrid'); // Mexuar\nbox(10,6,0,16,9,20,0xc94c4c,'nasrid'); // Comares\nbox(10,6,-18,22,7,14,0xc94c4c,'nasrid'); // Leones\nbox(25,6,0,12,8,16,0xc94c4c,'nasrid'); // Lindaraja\n\n// Alcazaba\nconst alc=box(-70,0,50,45,12,35,0x8b7355,'fort');\nwall(-70,50,45,1,14,0x8b7355);\nwall(-70,68,1,35,14,0x8b7355);\n\n// Generalife\nbox(70,0,-60,30,4,50,0x2e7d32,'garden');\nbox(70,4,-60,24,2,44,0x2e7d32,'garden');\n\n// Torres y muros perimetrales\nfor(let x=-120;x<=120;x+=40){\n  box(x,0,90,4,18,4,0x9e9e9e,'other');\n  box(x,0,-90,4,18,4,0x9e9e9e,'other');\n}\nfor(let z=-90;z<=90;z+=30){\n  box(120,0,z,4,18,4,0x9e9e9e,'other');\n  box(-120,0,z,4,18,4,0x9e9e9e,'other');\n}\n\n// Edificios auxiliares\nbox(-30,0,-70,26,5,20,0xa08a6b,'other'); // palacio Carlos V\nbox(-30,0,70,20,5,16,0xa08a6b,'other'); // Santa María\n\nconst stops=[\n {name:'Entrada / Puerta de la Justicia',pos:[-10,0,-110],txt:'Acceso principal al recinto, puerta nazarí del siglo XIV.'},\n {name:'Alcazaba',pos:[-70,0,50],txt:'Fortaleza militar más antigua, con vistas a Granada.'},\n {name:'Palacios Nazaríes',pos:[0,0,0],txt:'Mexuar, Comares, Palacio de los Leones: joya del arte nazarí.'},\n {name:'Patio de los Leones',pos:[10,0,-18],txt:'Fuente de los Doce Leones y galerías de estuco.'},\n {name:'Palacio de Carlos V',pos:[-30,0,-70],txt:'Renacimiento, sede del Museo de la Alhambra.'},\n {name:'Generalife',pos:[70,0,-60],txt:'Palacio de verano y jardines escalonados.'},\n {name:'Ruta completa',pos:[0,0,0],txt:'Recorrido circular por todos los puntos.'}\n];\n\nconst stopGroup=new THREE.Group();\nscene.add(stopGroup);\nconst markers=[];\nstops.forEach((s,i)=>{\n  const m=new THREE.Mesh(new THREE.SphereGeometry(2.4,16,16),new THREE.MeshStandardMaterial({color:0xd4af37,emissive:0x7a5a00}));\n  m.position.set(s.pos[0],4,s.pos[2]);\n  m.userData={index:i};\n  stopGroup.add(m);\n  markers.push(m);\n  const div=document.createElement('div');div.className='label';div.textContent=s.name;\n  const lbl=new THREE.CSS2DObject(div);\n  lbl.position.set(s.pos[0],12,s.pos[2]);\n  stopGroup.add(lbl);\n});\n\nconst curvePoints=stops.slice(0,6).map(s=>new THREE.Vector3(s.pos[0],4,s.pos[2]));\ncurvePoints.push(new THREE.Vector3(stops[0].pos[0],4,stops[0].pos[2]));\nconst curve=new THREE.CatmullRomCurve3(curvePoints,true);\nconst tube=new THREE.Mesh(new THREE.TubeGeometry(curve,200,0.8,8,false),new THREE.MeshStandardMaterial({color:0xd4af37,emissive:0x6b5a00}));\nscene.add(tube);\n\nconst walker=new THREE.Mesh(new THREE.SphereGeometry(1.8,16,16),new THREE.MeshStandardMaterial({color:0xffffff,emissive:0xffffff}));\nscene.add(walker);\n\nconst stopsDiv=document.getElementById('stops');\nstops.forEach((s,i)=>{\n  const b=document.createElement('button');b.className='stop';b.textContent=s.name.split('/')[0].trim();\n  b.onclick=()=>gotoStop(i);stopsDiv.appendChild(b);\n});\ndocument.getElementById('tourBtn').onclick=startTour;\ndocument.getElementById('resetBtn').onclick=resetView;\nconst info=document.getElementById('info');\n\nlet touring=false,tourT=0;\nfunction startTour(){touring=true;tourT=0;}\nfunction resetView(){camera.position.set(0,120,160);controls.target.set(0,0,0);touring=false;}\nfunction gotoStop(i){\n  const s=stops[i];\n  info.textContent=s.name+': '+s.txt;\n  camera.position.set(s.pos[0],40,s.pos[2]+35);\n  controls.target.set(s.pos[0],0,s.pos[2]);\n  touring=false;\n}\nconst ray=new THREE.Raycaster();\nconst mouse=new THREE.Vector2();\nrenderer.domElement.addEventListener('click',e=>{\n  mouse.x=(e.clientX/innerWidth)*2-1;\n  mouse.y=-(e.clientY/innerHeight)*2+1;\n  ray.setFromCamera(mouse,camera);\n  const hits=ray.intersectObjects(markers);\n  if(hits.length){gotoStop(hits[0].object.userData.index);}\n});\n\nlet prev=performance.now();\nfunction animate(){\n  requestAnimationFrame(animate);\n  const now=performance.now();\n  const dt=Math.min(0.05,(now-prev)/1000);prev=now;\n  if(touring){\n    tourT=(tourT+dt*0.08)%1;\n    const p=curve.getPointAt(tourT);\n    walker.position.copy(p);\n    camera.position.lerp(new THREE.Vector3(p.x+25,p.y+30,p.z+25),0.05);\n    controls.target.lerp(new THREE.Vector3(p.x,0,p.z),0.1);\n  }else{\n    const t=now*0.001;\n    walker.position.copy(curve.getPointAt((Math.sin(t*0.1)*0.5+0.5)));\n  }\n  controls.update();\n  renderer.render(scene,camera);\n  labelRenderer.render(scene,camera);\n}\nanimate();\n\nwindow.addEventListener('resize',()=>{\n  camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();\n  renderer.setSize(innerWidth,innerHeight);labelRenderer.setSize(innerWidth,innerHeight);\n});\n</script>\n</body>\n</html>\n"
