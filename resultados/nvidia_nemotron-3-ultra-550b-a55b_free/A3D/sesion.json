              "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Ruta 3D - Alhambra de Granada</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { overflow: hidden; font-family: 'Segoe UI', sans-serif; background: #0a0f1a; }\n    canvas { display: block; }\n    #ui {\n      position: fixed; top: 20px; left: 20px; z-index: 100;\n      color: #e8d5b7; text-shadow: 0 2px 10px rgba(0,0,0,0.8);\n    }\n    #ui h1 { font-size: 1.8rem; font-weight: 300; letter-spacing: 2px; margin-bottom: 0.5rem; }\n    #ui p { font-size: 0.9rem; opacity: 0.7; line-height: 1.6; max-width: 300px; }\n    #controls {\n      position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 100;\n      display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;\n    }\n    .btn {\n      background: linear-gradient(135deg, #2a1f15, #3d2a1a);\n      border: 1px solid #5a4430; color: #e8d5b7;\n      padding: 12px 24px; border-radius: 30px; cursor: pointer;\n      font-size: 0.85rem; letter-spacing: 1px; text-transform: uppercase;\n      transition: all 0.3s ease; backdrop-filter: blur(10px);\n    }\n    .btn:hover { background: linear-gradient(135deg, #3d2a1a, #5a4430); border-color: #c9a86c; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(201,168,108,0.3); }\n    .btn.active { background: linear-gradient(135deg, #c9a86c, #a68a4a); border-color: #c9a86c; color: #1a1208; }\n    #info-panel {\n      position: fixed; right: 20px; top: 20px; z-index: 100;\n      width: 280px; max-height: 70vh; overflow-y: auto;\n      background: rgba(15,10,5,0.9); border: 1px solid #3d2a1a;\n      border-radius: 12px; padding: 20px; color: #e8d5b7;\n      backdrop-filter: blur(15px); display: none;\n    }\n    #info-panel.open { display: block; animation: slideIn 0.4s ease; }\n    @keyframes slideIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }\n    #info-panel h3 { font-size: 1.1rem; margin-bottom: 12px; color: #c9a86c; border-bottom: 1px solid #3d2a1a; padding-bottom: 8px; }\n    .stop { padding: 10px 0; border-bottom: 1px solid #2a1f15; cursor: pointer; transition: 0.2s; }\n    .stop:hover { color: #c9a86c; padding-left: 8px; }\n    .stop:last-child { border-bottom: none; }\n    .stop-num { display: inline-block; width: 24px; height: 24px; background: #3d2a1a; border-radius: 50%; text-align: center; line-height: 24px; font-size: 0.75rem; margin-right: 10px; color: #c9a86c; }\n    .stop.active .stop-num { background: #c9a86c; color: #1a1208; }\n    .progress-bar { position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%); width: 60%; max-width: 500px; height: 4px; background: #2a1f15; border-radius: 2px; overflow: hidden; z-index: 100; }\n    .progress-fill { height: 100%; background: linear-gradient(90deg, #c9a86c, #e8d5b7); width: 0%; transition: width 1s cubic-bezier(0.4,0,0.2,1); border-radius: 2px; }\n    #legend { position: fixed; bottom: 20px; right: 20px; z-index: 100; color: #e8d5b7; font-size: 0.75rem; opacity: 0.7; text-align: right; line-height: 1.8; }\n    .loading { position: fixed; inset: 0; background: #0a0f1a; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 200; color: #c9a86c; gap: 20px; }\n    .loading-bar { width: 200px; height: 3px; background: #2a1f15; border-radius: 3px; overflow: hidden; }\n    .loading-fill { height: 100%; background: linear-gradient(90deg, #c9a86c, #e8d5b7); width: 0%; animation: load 3s ease forwards; }\n    @keyframes load { to { width: 100%; } }\n  </style>\n</head>\n<body>\n  <div class=\"loading\" id=\"loading\">\n    <div style=\"font-size: 1.5rem; letter-spacing: 4px; font-weight: 300;\">ALHAMBRA</div>\n    <div class=\"loading-bar\"><div class=\"loading-fill\"></div></div>\n    <div style=\"font-size: 0.8rem; opacity: 0.6;\">Cargando ruta histórica...</div>\n  </div>\n\n  <div id=\"ui\">\n    <h1>RUTA 3D ALHAMBRA</h1>\n    <p>Recorrido virtual por el conjunto monumental nazarí</p>\n  </div>\n\n  <div id=\"controls\">\n    <button class=\"btn\" id=\"btnPlay\" onclick=\"togglePlay()\">▶ Iniciar Tour</button>\n    <button class=\"btn\" id=\"btnPause\" onclick=\"togglePause()\" style=\"display:none\">⏸ Pausar</button>\n    <button class=\"btn\" onclick=\"resetTour()\">⟲ Reiniciar</button>\n    <button class=\"btn\" id=\"btnInfo\" onclick=\"toggleInfo()\">ℹ Paradas</button>\n  </div>\n\n  <div class=\"progress-bar\"><div class=\"progress-fill\" id=\"progressFill\"></div></div>\n\n  <div id=\"info-panel\">\n    <h3>PARADAS DEL RECORRIDO</h3>\n    <div id=\"stopsList\"></div>\n  </div>\n\n  <div id=\"legend\">\n    🖱 Arrastrar = Rotar vista<br>\n    🖱 Scroll = Zoom<br>\n    ⌨ Espacio = Play/Pausa\n  </div>\n\n  <script type=\"importmap\">\n  {\n    \"imports\": {\n      \"three\": \"https://unpkg.com/three@0.160.0/build/three.module.js\",\n      \"three/addons/\": \"https://unpkg.com/three@0.160.0/examples/jsm/\"\n    }\n  }\n  </script>\n  <script type=\"module\">\n    import * as THREE from 'three';\n    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n    import { CSS2DRenderer, CSS2DObject } from 'three/addons/renderers/CSS2DRenderer.js';\n\n    // ── Configuración ──\n    const STOPS = [\n      { name: \"Puerta de la Justicia\", pos: [-45, 2, -20], desc: \"Entrada principal fortificada (1348)\", info: \"Arco de herradura apuntado con inscripción coránica y mano de Fátima\" },\n      { name: \"Plaza de los Aljibes\", pos: [-20, 2, -15], desc: \"Espacio abierto con aljibes medievales\", info: \"Depósitos de agua que abastecían la fortaleza\" },\n      { name: \"Alcazaba - Torre de la Vela\", pos: [5, 18, -25], desc: \"Torre vigía más alta (27m)\", info: \"Campana que marcaba el ritmo de vida y alertas de la ciudad\" },\n      { name: \"Palacio de Carlos V\", pos: [-10, 3, 10], desc: \"Palacio renacentista circular (1527)\", info: \"Patio circular único en España, 30m de diámetro\" },\n      { name: \"Patio de los Arrayanes\", pos: [-35, 2, 25], desc: \"Corazón del Palacio de Comares\", info: \"Estanque central refleja la fachada norte; arrayanes (mirtos) en setos\" },\n      { name: \"Salón de los Embajadores\", pos: [-35, 8, 35], desc: \"Sala del trono nazarí\", info: \"Cúpula de 8000 piezas de madera; techo representa los 7 cielos\" },\n      { name: \"Patio de los Leones\", pos: [-15, 2, 30], desc: \"Icono del arte nazarí (s.XIV)\", info: \"12 leones sostienen la taza; símbolo del paraíso coránico\" },\n      { name: \"Sala de los Abencerrajes\", pos: [-5, 6, 35], desc: \"Leyenda de los caballeros degollados\", info: \"Cúpula de mocárabes en forma de estrella de 8 puntas\" },\n      { name: \"Sala de los Reyes\", pos: [5, 6, 30], desc: \"Pinturas de 10 reyes nazaríes\", info: \"Único techo figurativo conservado; escenas cortesanas\" },\n      { name: \"Mirador de Daraxa\", pos: [15, 4, 25], desc: \"Vistas al Albaicín y Sierra Nevada\", info: \"Ventanas ajimezadas con celosías de yeso\" },\n      { name: \"Baños Reales\", pos: [25, 1, 15], desc: \"Hammam nazarí mejor conservado\", info: \"Sala fría, templada y caliente; bóvedas con lucernarios estrellados\" },\n      { name: \"Generalife - Patio de la Acequia\", pos: [55, 3, 0], desc: \"Villa de recreo de los sultanes\", info: \"Canal central con surtidores; jardines en terrazas\" },\n      { name: \"Escalera del Agua\", pos: [65, 10, -5], desc: \"Escalinata con canaletas de agua\", info: \"El agua fluye por barandillas huecas; ingeniería hidráulica única\" },\n      { name: \"Teatro del Generalife\", pos: [70, 5, 10], desc: \"Escenario al aire libre (1952)\", info: \"Festival de Música y Danza; aforo 1000 personas\" },\n    ];\n\n    // ── Three.js Setup ──\n    const scene = new THREE.Scene();\n    scene.fog = new THREE.FogExp2(0x0a0f1a, 0.0035);\n\n    const camera = new THREE.PerspectiveCamera(55, innerWidth/innerHeight, 0.1, 500);\n    camera.position.set(-60, 35, -40);\n\n    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(innerWidth, innerHeight);\n    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.1;\n    document.body.appendChild(renderer.domElement);\n\n    const labelRenderer = new CSS2DRenderer();\n    labelRenderer.setSize(innerWidth, innerHeight);\n    labelRenderer.domElement.style.position = 'absolute';\n    labelRenderer.domElement.style.top = '0';\n    labelRenderer.domElement.style.pointerEvents = 'none';\n    document.body.appendChild(labelRenderer.domElement);\n\n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.05;\n    controls.minDistance = 15;\n    controls.maxDistance = 180;\n    controls.maxPolarAngle = Math.PI / 2 - 0.05;\n    controls.target.set(-10, 3, 10);\n\n    // ── Luces ──\n    const hemi = new THREE.HemisphereLight(0xffeedd, 0x1a1008, 0.8);\n    scene.add(hemi);\n\n    const sun = new THREE.DirectionalLight(0xfff5e0, 2.5);\n    sun.position.set(80, 120, 50);\n    sun.castShadow = true;\n    sun.shadow.mapSize.set(2048, 2048);\n    sun.shadow.camera.near = 1;\n    sun.shadow.camera.far = 300;\n    sun.shadow.camera.left = -100;\n    sun.shadow.camera.right = 100;\n    sun.shadow.camera.top = 100;\n    sun.shadow.camera.bottom = -100;\n    sun.shadow.bias = -0.0005;\n    scene.add(sun);\n\n    const fillLight = new THREE.DirectionalLight(0xffedd0, 0.6);\n    fillLight.position.set(-50, 40, -30);\n    scene.add(fillLight);\n\n    // ── Suelo / Terreno ──\n    const groundGeo = new THREE.PlaneGeometry(300, 300, 120, 120);\n    const pos = groundGeo.attributes.position;\n    for (let i = 0; i < pos.count; i++) {\n      const x = pos.getX(i), z = pos.getZ(i);\n      const d = Math.sqrt(x*x + z*z);\n      pos.setY(i, Math.sin(x*0.08)*0.6 + Math.cos(z*0.07)*0.5 + Math.sin(d*0.05)*0.4);\n      if (d < 80) pos.setY(i, pos.getY(i) + Math.sin(x*0.15)*0.3);\n    }\n    groundGeo.computeVertexNormals();\n\n    const groundMat = new THREE.MeshStandardMaterial({\n      color: 0x2d2218, roughness: 0.9, metalness: 0.05,\n      vertexColors: false\n    });\n    const ground = new THREE.Mesh(groundGeo, groundMat);\n    ground.rotation.x = -Math.PI/2;\n    ground.receiveShadow = true;\n    scene.add(ground);\n\n    // ── Materiales reutilizables ──\n    const wallMat = new THREE.MeshStandardMaterial({ color: 0xd4b88a, roughness: 0.7, metalness: 0.1 });\n    const roofMat = new THREE.MeshStandardMaterial({ color: 0x8b3a2a, roughness: 0.6, metalness: 0.1 });\n    const trimMat = new THREE.MeshStandardMaterial({ color: 0xc9a86c, roughness: 0.4, metalness: 0.3 });\n    const waterMat = new THREE.MeshStandardMaterial({ color: 0x1a3a4a, roughness: 0.1, metalness: 0.9, transparent: true, opacity: 0.85 });\n    const woodMat = new THREE.MeshStandardMaterial({ color: 0x5d3a1a, roughness: 0.8, metalness: 0.05 });\n    const tileMat = new THREE.MeshStandardMaterial({ color: 0x1a4a3a, roughness: 0.5, metalness: 0.1 });\n    const marbleMat = new THREE.MeshStandardMaterial({ color: 0xf5f0e0, roughness: 0.3, metalness: 0.1 });\n    const stuccoMat = new THREE.MeshStandardMaterial({ color: 0xe8dcc8, roughness: 0.85, metalness: 0.02 });\n\n    // ── Funciones de construcción ──\n    function createBox(w, h, d, mat, pos, rot = [0,0,0]) {\n      const g = new THREE.BoxGeometry(w, h, d);\n      const m = new THREE.Mesh(g, mat);\n      m.position.set(...pos);\n      m.rotation.set(...rot);\n      m.castShadow = true; m.receiveShadow = true;\n      return m;\n    }\n\n    function createCylinder(r, h, mat, pos) {\n      const g = new THREE.CylinderGeometry(r, r, h, 16);\n      const m = new THREE.Mesh(g, mat);\n      m.position.set(...pos);\n      m.castShadow = true; m.receiveShadow = true;\n      return m;\n    }\n\n    function createArch(width, height, depth, mat, pos, rot = [0,0,0]) {\n      const group = new THREE.Group();\n      const pillarW = 1.2;\n      group.add(createBox(pillarW, height, depth, mat, [-width/2 + pillarW/2, height/2, 0]));\n      group.add(createBox(pillarW, height, depth, mat, [width/2 - pillarW/2, height/2, 0]));\n      group.add(createBox(width, 1.5, depth, mat, [0, height + 0.75, 0]));\n      group.position.set(...pos);\n      group.rotation.set(...rot);\n      return group;\n    }\n\n    function addMocarabes(parent, x, y, z, scale = 1) {\n      const count = 5;\n      for (let i = 0; i < count; i++) {\n        const s = 0.3 * scale * (1 - i * 0.15);\n        const g = new THREE.ConeGeometry(s, s*2, 8);\n        const m = new THREE.Mesh(g, stuccoMat);\n        m.position.set(x, y - i * s * 1.5, z);\n        m.rotation.x = Math.PI;\n        m.castShadow = true;\n        parent.add(m);\n      }\n    }\n\n    // ── Construir Alhambra ──\n    const alhambra = new THREE.Group();\n    scene.add(alhambra);\n\n    // Alcazaba (zona oeste)\n    const alcazaba = new THREE.Group();\n    alcazaba.add(createBox(50, 12, 40, wallMat, [30, 6, -25]));\n    alcazaba.add(createBox(12, 27, 12, wallMat, [52, 19.5, -37])); // Torre de la Vela\n    alcazaba.add(createCylinder(6, 8, roofMat, [52, 31, -37]));\n    for (let x = 15; x <= 45; x += 10) {\n      alcazaba.add(createBox(3, 14, 44, wallMat, [x, 7, -25]));\n    }\n    alhambra.add(alcazaba);\n\n    // Palacio de Carlos V\n    const carlosV = new THREE.Group();\n    const outerR = 30, innerR = 15, h = 17;\n    const ringGeo = new THREE.CylinderGeometry(outerR, outerR, h, 32, 1, true);\n    const ringMat = wallMat.clone(); ringMat.color.set(0xc8a87a);\n    const ring = new THREE.Mesh(ringGeo, ringMat);\n    ring.position.set(-10, h/2 + 1, 10);\n    ring.castShadow = true; ring.receiveShadow = true;\n    carlosV.add(ring);\n    // Patio interior columnas\n    for (let i = 0; i < 32; i++) {\n      const a = (i/32)*Math.PI*2;\n      carlosV.add(createCylinder(0.45, 15, marbleMat, [-10 + Math.cos(a)*innerR, 8.5, 10 + Math.sin(a)*innerR]));\n    }\n    carlosV.add(createCylinder(innerR, 0.5, tileMat, [-10, 17.5, 10])); // cornisa\n    alhambra.add(carlosV);\n\n    // Palacios Nazaríes (Comares + Leones)\n    const nazaries = new THREE.Group();\n\n    // Palacio de Comares - Torre\n    nazaries.add(createBox(28, 22, 28, wallMat, [-35, 11, 25]));\n    nazaries.add(createCylinder(14, 6, roofMat, [-35, 25, 25]));\n    // Fachada norte - Patio Arrayanes\n    nazaries.add(createArch(10, 8, 2, wallMat, [-35, 4, 12], [0,0,0]));\n    nazaries.add(createBox(20, 1, 0.5, marbleMat, [-35, 0.5, 11.5])); // estanque base\n    nazaries.add(createBox(18.5, 0.3, 18.5, waterMat, [-35, 1.15, 11.5])); // agua\n    // Arrayanes (setos)\n    for (let x = -44; x <= -26; x += 2) {\n      nazaries.add(createBox(1.5, 1.2, 18, new THREE.MeshStandardMaterial({color:0x1a4a2a}), [x, 0.6, 11.5]));\n    }\n\n    // Salón Embajadores (interior)\n    nazaries.add(createBox(14, 14, 14, stuccoMat, [-35, 7, 35]));\n    nazaries.add(createCylinder(7, 4, stuccoMat, [-35, 18, 35]));\n    for (let i=0;i<8;i++) addMocarabes(nazaries, -35 + Math.cos(i*Math.PI/4)*5, 20, 35 + Math.sin(i*Math.PI/4)*5);\n\n    // Palacio de los Leones\n    nazaries.add(createBox(32, 10, 32, wallMat, [-15, 5, 30]));\n    nazaries.add(createCylinder(16, 3, roofMat, [-15, 11.5, 30]));\n    // Patio Leones\n    nazaries.add(createBox(20, 0.5, 20, marbleMat, [-15, 0.25, 30]));\n    // Fuente Leones\n    const fountain = new THREE.Group();\n    fountain.add(createCylinder(2.5, 1.2, marbleMat, [0, 0.6, 0]));\n    for (let i=0;i<12;i++) {\n      const a = (i/12)*Math.PI*2;\n      const lion = createCylinder(0.35, 1.2, marbleMat, [Math.cos(a)*2.2, 1.2, Math.sin(a)*2.2]);\n      lion.rotation.z = -a + Math.PI/2;\n      fountain.add(lion);\n    }\n    fountain.add(createCylinder(1.5, 2, marbleMat, [0, 2.2, 0]));\n    fountain.position.set(-15, 0, 30);\n    nazaries.add(fountain);\n    // Columnas perimetrales\n    for (let i=0;i<32;i++) {\n      const a = (i/32)*Math.PI*2;\n      nazaries.add(createCylinder(0.4, 6, marbleMat, [-15+Math.cos(a)*11, 3, 30+Math.sin(a)*11]));\n    }\n\n    // Sala Abencerrajes\n    nazaries.add(createBox(12, 10, 12, stuccoMat, [-5, 5, 35]));\n    nazaries.add(createCylinder(6, 5, stuccoMat, [-5, 12.5, 35]));\n    for (let i=0;i<8;i++) addMocarabes(nazaries, -5+Math.cos(i*Math.PI/4)*4, 15, 35+Math.sin(i*Math.PI/4)*4, 0.8);\n\n    // Sala Reyes\n    nazaries.add(createBox(14, 10, 10, stuccoMat, [5, 5, 30]));\n    nazaries.add(createCylinder(7, 4, stuccoMat, [5, 12, 30]));\n\n    // Mirador Daraxa\n    nazaries.add(createBox(10, 8, 6, wallMat, [15, 4, 25]));\n    nazaries.add(createCylinder(5, 3, roofMat, [15, 10, 25]));\n    for (let i=0;i<3;i++) {\n      nazaries.add(createBox(1.5, 3, 0.2, trimMat, [15+2.5, 3+i*2, 28]));\n      nazaries.add(createBox(1.5, 3, 0.2, trimMat, [15-2.5, 3+i*2, 28]));\n    }\n\n    // Baños Reales\n    nazaries.add(createBox(18, 6, 14, wallMat, [25, 3, 15]));\n    nazaries.add(createCylinder(9, 2, roofMat, [25, 7, 15]));\n    for (let i=0;i<6;i++) {\n      const a = (i/6)*Math.PI*2;\n      nazaries.add(createBox(0.5, 0.5, 0.5, stuccoMat, [25+Math.cos(a)*6, 7.5, 15+Math.sin(a)*6]));\n    }\n\n    alhambra.add(nazaries);\n\n    // Generalife\n    const generalife = new THREE.Group();\n    // Palacio bajo\n    generalife.add(createBox(30, 7, 20, wallMat, [55, 3.5, 0]));\n    generalife.add(createCylinder(15, 2, roofMat, [55, 8, 0]));\n    // Patio Acequia\n    generalife.add(createBox(24, 0.4, 6, waterMat, [55, 0.5, 0]));\n    for (let i=0;i<5;i++) {\n      generalife.add(createCylinder(0.3, 0.8, waterMat, [55-10+i*5, 0.9, 0]));\n    }\n    // Jardines en terrazas\n    for (let t=0; t<3; t++) {\n      for (let x=-12; x<=12; x+=4) {\n        for (let z=-7; z<=7; z+=4) {\n          generalife.add(createCylinder(1.2, 0.8, new THREE.MeshStandardMaterial({color:0x2a5a2a}), [55+x, 1.5+t*2, z]));\n        }\n      }\n    }\n    // Escalera del Agua\n    const escalera = new THREE.Group();\n    for (let i=0; i<18; i++) {\n      escalera.add(createBox(4, 0.3, 0.8, marbleMat, [0, 0.5+i*0.55, -1.5+i*1.1]));\n      escalera.add(createBox(0.15, 0.4, 0.8, waterMat, [2.1, 0.7+i*0.55, -1.5+i*1.1]));\n      escalera.add(createBox(0.15, 0.4, 0.8, waterMat, [-2.1, 0.7+i*0.55, -1.5+i*1.1]));\n    }\n    escalera.position.set(65, 1, -5);\n    generalife.add(escalera);\n    // Teatro\n    generalife.add(createBox(20, 6, 15, wallMat, [70, 3, 10]));\n    generalife.add(createCylinder(10, 2, roofMat, [70, 8, 10]));\n\n    alhambra.add(generalife);\n\n    // Vegetación dispersa\n    const trees = new THREE.Group();\n    const treePositions = [\n      [-50, -30], [-30, -40], [-10, -35], [10, -25], [40, -30],\n      [-60, 10], [-45, 35], [-20, 40], [20, 45], [50, 20],\n      [65, 15], [75, 5], [60, -10], [40, 30]\n    ];\n    treePositions.forEach(([x,z]) => {\n      const trunk = createCylinder(0.6, 4, woodMat, [x, 2, z]);\n      const crown = new THREE.Mesh(\n        new THREE.ConeGeometry(2.5, 5, 8),\n        new THREE.MeshStandardMaterial({color:0x1a4a1a, roughness:0.9})\n      );\n      crown.position.set(x, 6.5, z);\n      crown.castShadow = true;\n      trees.add(trunk, crown);\n    });\n    scene.add(trees);\n\n    // Partículas de polvo/luz\n    const particlesGeo = new THREE.BufferGeometry();\n    const pCount = 1500;\n    const pPos = new Float32Array(pCount * 3);\n    const pSize = new Float32Array(pCount);\n    for (let i=0;i<pCount;i++) {\n      pPos[i*3] = (Math.random()-0.5)*200;\n      pPos[i*3+1] = Math.random()*50 + 1;\n      pPos[i*3+2] = (Math.random()-0.5)*200;\n      pSize[i] = Math.random()*2 + 0.5;\n    }\n    particlesGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));\n    particlesGeo.setAttribute('size', new THREE.BufferAttribute(pSize, 1));\n    const particlesMat = new THREE.PointsMaterial({\n      color: 0xfff0d0, size: 1, transparent: true, opacity: 0.4,\n      sizeAttenuation: true, depthWrite: false\n    });\n    const particles = new THREE.Points(particlesGeo, particlesMat);\n    scene.add(particles);\n\n    // ── Etiquetas CSS2D ──\n    const labels = [];\n    STOPS.forEach((stop, i) => {\n      const div = document.createElement('div');\n      div.className = 'stop-label';\n      div.style.cssText = `\n        background: linear-gradient(135deg, rgba(20,15,8,0.95), rgba(40,30,20,0.9));\n        border: 1px solid #5a4430; border-radius: 8px; padding: 8px 12px;\n        color: #e8d5b7; font-size: 0.75rem; white-space: nowrap;\n        box-shadow: 0 4px 20px rgba(0,0,0,0.5); pointer-events: none;\n        font-weight: 500; letter-spacing: 0.5px;\n      `;\n      div.innerHTML = `<span style=\"color:#c9a86c\">${i+1}.</span> ${stop.name}`;\n      const label = new CSS2DObject(div);\n      label.position.set(...stop.pos);\n      label.position.y += 5;\n      scene.add(label);\n      labels.push(label);\n    });\n\n    // ── Ruta curva (CatmullRom) ──\n    const curvePoints = STOPS.map(s => new THREE.Vector3(...s.pos).add(new THREE.Vector3(0, 4, 0)));\n    const curve = new THREE.CatmullRomCurve3(curvePoints, false, 'centripetal', 0.3);\n    const pathPoints = curve.getPoints(400);\n\n    // Línea de ruta visible\n    const lineGeo = new THREE.BufferGeometry().setFromPoints(pathPoints);\n    const lineMat = new THREE.LineBasicMaterial({\n      color: 0xc9a86c, transparent: true, opacity: 0.6, linewidth: 2\n    });\n    const pathLine = new THREE.Line(lineGeo, lineMat);\n    scene.add(pathLine);\n\n    // Marcador animado\n    const markerGeo = new THREE.SphereGeometry(0.6, 16, 16);\n    const markerMat = new THREE.MeshBasicMaterial({ color: 0xfff0c0, transparent: true, opacity: 1 });\n    const marker = new THREE.Mesh(markerGeo, markerMat);\n    scene.add(marker);\n\n    // Estela de partículas detrás del marcador\n    const trailGeo = new THREE.BufferGeometry();\n    const trailCount = 30;\n    const trailPos = new Float32Array(trailCount * 3);\n    const trailAlpha = new Float32Array(trailCount);\n    trailGeo.setAttribute('position', new THREE.BufferAttribute(trailPos, 3));\n    trailGeo.setAttribute('alpha', new THREE.BufferAttribute(trailAlpha, 1));\n    const trailMat = new THREE.PointsMaterial({\n      color: 0xc9a86c, size: 0.8, transparent: true, opacity: 1,\n      sizeAttenuation: true, depthWrite: false, vertexColors: false\n    });\n    const trail = new THREE.Points(trailGeo, trailMat);\n    scene.add(trail);\n\n    // ── UI: lista de paradas ──\n    const stopsList = document.getElementById('stopsList');\n    STOPS.forEach((stop, i) => {\n      const el = document.createElement('div');\n      el.className = 'stop' + (i===0?' active':'');\n      el.innerHTML = `<span class=\"stop-num\">${i+1}</span>${stop.name}`;\n      el.onclick = () => jumpToStop(i);\n      stopsList.appendChild(el);\n    });\n\n    // ── Estado del tour ──\n    let playing = false;\n    let progress = 0; // 0-1\n    const duration = 120; // segundos\n    let currentStopIndex = 0;\n    let lastTime = 0;\n\n    function updateProgressUI() {\n      document.getElementById('progressFill').style.width = (progress*100)+'%';\n      const stops = document.querySelectorAll('.stop');\n      stops.forEach((el, i) => el.classList.toggle('active', i === currentStopIndex));\n    }\n\n    function togglePlay() {\n      playing = true;\n      document.getElementById('btnPlay').style.display = 'none';\n      document.getElementById('btnPause').style.display = 'inline-flex';\n      lastTime = performance.now();\n    }\n    function togglePause() {\n      playing = false;\n      document.getElementById('btnPlay').style.display = 'inline-flex';\n      document.getElementById('btnPause').style.display = 'none';\n    }\n    function resetTour() {\n      progress = 0;\n      currentStopIndex = 0;\n      playing = false;\n      document.getElementById('btnPlay').style.display = 'inline-flex';\n      document.getElementById('btnPause').style.display = 'none';\n      updateProgressUI();\n      updateCamera(0);\n    }\n    function toggleInfo() {\n      document.getElementById('info-panel').classList.toggle('open');\n    }\n    function jumpToStop(i) {\n      const stopProgress = i / (STOPS.length - 1);\n      progress = stopProgress;\n      currentStopIndex = i;\n      updateProgressUI();\n      updateCamera(progress);\n    }\n\n    window.togglePlay = togglePlay;\n    window.togglePause = togglePause;\n    window.resetTour = resetTour;\n    window.toggleInfo = toggleInfo;\n    window.jumpToStop = jumpToStop;\n\n    // ── Teclas ──\n    window.addEventListener('keydown', e => {\n      if (e.code === 'Space') { e.preventDefault(); playing ? togglePause() : togglePlay(); }\n      if (e.code === 'KeyR') resetTour();\n      if (e.code === 'KeyI') toggleInfo();\n    });\n\n    // ── Actualizar cámara siguiendo la curva ──\n    function updateCamera(t) {\n      const point = curve.getPoint(t);\n      const tangent = curve.getTangent(t).normalize();\n      const normal = new THREE.Vector3(0,1,0).cross(tangent).normalize();\n      const binormal = tangent.clone().cross(normal);\n\n      // Posición de cámara: detrás y arriba del punto\n      const camOffset = new THREE.Vector3()\n        .subVectors(\n          tangent.clone().multiplyScalar(-18),\n          new THREE.Vector3(0, -12, 0)\n        )\n        .add(binormal.clone().multiplyScalar(Math.sin(t*Math.PI*4)*2));\n      camera.position.lerp(point.clone().add(camOffset), 0.08);\n\n      // Mirar ligeramente adelante\n      const lookAhead = curve.getPoint(Math.min(1, t + 0.02));\n      controls.target.lerp(lookAhead.clone().add(new THREE.Vector3(0, 2, 0)), 0.08);\n\n      // Actualizar marcador\n      marker.position.lerp(point, 0.15);\n      marker.scale.setScalar(0.8 + Math.sin(performance.now()*0.005)*0.2);\n\n      // Estela\n      const trailPositions = trailGeo.attributes.position.array;\n      const trailAlphas = trailGeo.attributes.alpha.array;\n      for (let i = trailCount - 1; i > 0; i--) {\n        trailPositions[i*3] = trailPositions[(i-1)*3];\n        trailPositions[i*3+1] = trailPositions[(i-1)*3+1];\n        trailPositions[i*3+2] = trailPositions[(i-1)*3+2];\n        trailAlphas[i] = trailAlphas[i-1] * 0.92;\n      }\n      trailPositions[0] = point.x;\n      trailPositions[1] = point.y;\n      trailPositions[2] = point.z;\n      trailAlphas[0] = 1;\n      trailGeo.attributes.position.needsUpdate = true;\n      trailGeo.attributes.alpha.needsUpdate = true;\n\n      // Detectar parada actual\n      const newStopIndex = Math.floor(t * (STOPS.length - 1) + 0.5);\n      if (newStopIndex !== currentStopIndex && newStopIndex >= 0 && newStopIndex < STOPS.length) {\n        currentStopIndex = newStopIndex;\n        updateProgressUI();\n      }\n    }\n\n    // ── Animación ──\n    function animate(time) {\n      requestAnimationFrame(animate);\n\n      const dt = (time - lastTime) / 1000;\n      lastTime = time;\n\n      if (playing) {\n        progress += dt / duration;\n        if (progress >= 1) {\n          progress = 1;\n          playing = false;\n          document.getElementById('btnPlay').style.display = 'inline-flex';\n          document.getElementById('btnPause').style.display = 'none';\n        }\n        updateProgressUI();\n      }\n\n      updateCamera(progress);\n\n      // Rotar partículas sutiles\n      particles.rotation.y += 0.00003;\n\n      // Animar etiquetas - ocultar las lejanas\n      labels.forEach((label, i) => {\n        const dist = camera.position.distanceTo(label.position);\n        label.element.style.opacity = dist < 80 ? 1 : Math.max(0, 1 - (dist-80)/40);\n        label.element.style.transform = `scale(${Math.max(0.7, 1 - dist/200)})`;\n      });\n\n      controls.update();\n      renderer.render(scene, camera);\n      labelRenderer.render(scene, camera);\n    }\n\n    // ── Resize ──\n    window.addEventListener('resize', () => {\n      camera.aspect = innerWidth / innerHeight;\n      camera.updateProjectionMatrix();\n      renderer.setSize(innerWidth, innerHeight);\n      labelRenderer.setSize(innerWidth, innerHeight);\n    });\n\n    // ── Ocultar loading ──\n    setTimeout(() => {\n      document.getElementById('loading').style.opacity = '0';\n      document.getElementById('loading').style.transition = 'opacity 0.8s';\n      setTimeout(() => document.getElementById('loading').remove(), 800);\n      animate(performance.now());\n    }, 2800);\n  </script>\n</body>\n</html>"
