# Puerto y red
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=false

# Redis (fuente de verdad del carrito)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=cartsvc:
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_MAX_RETRIES=2
REDIS_TLS=false

# Reglas del carrito
CART_TTL_SECONDS=1209600
CART_MAX_ITEMS=200
CART_MAX_QUANTITY_PER_LINE=99
CART_MAX_ACTIVE_PER_USER=5

# Caché local de lecturas (0 = desactivada)
CACHE_TTL_MS=2000
CACHE_MAX_ENTRIES=10000

# Rate limiting distribuido
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SECOND=20

# Idempotencia
IDEMPOTENCY_TTL_SECONDS=86400

# Precios e impuestos (importes en céntimos)
SHIPPING_FLAT_CENTS=499
FREE_SHIPPING_THRESHOLD_CENTS=5000
TAX_BPS=2100
PROMO_RULES={"WELCOME10":{"type":"percent","bps":1000,"maxDiscountCents":2000},"SAVE5":{"type":"fixed","amountCents":500,"minSubtotalCents":3000}}

# Autenticación (usa un secreto largo y aleatorio en producción)
JWT_SECRET=cambia-este-secreto
JWT_ISSUER=carrito-escalable

# Catálogo de productos
CATALOG_MODE=memory
CATALOG_URL=
CATALOG_TIMEOUT_MS=1500

# Evento analítico por lectura (desactivado: cada lectura sería una escritura)
TRACK_VIEWS=false

# Worker de eventos
WORKER_CONSUMER_GROUP=cart-events
WORKER_CONSUMER_NAME=worker-1
WORKER_BATCH_SIZE=50
WORKER_BLOCK_MS=2000
