{
  "name": "carrito-escalable",
  "version": "1.0.0",
  "private": true,
  "description": "Carrito de la compra escalable: API stateless, Redis con versionado optimista, idempotencia, eventos y rate limiting distribuido",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "load": "k6 run test/load/cart.js",
    "token": "tsx scripts/create-token.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.14.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.8"
  }
}
